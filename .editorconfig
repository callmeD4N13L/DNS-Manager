# ------------------------------------------------------------------
# EditorConfig — https://editorconfig.org
# ------------------------------------------------------------------
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,cc,cxx,h,hpp,hxx}]
indent_style = space
indent_size = 4
tab_width = 4

[*.{qml,js}]
indent_style = space
indent_size = 4
tab_width = 4

[*.{cmake,CMakeLists.txt}]
indent_style = space
indent_size = 4
tab_width = 4

[*.json]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sh]
indent_style = space
indent_size = 4

[*.ps1]
indent_style = space
indent_size = 4
