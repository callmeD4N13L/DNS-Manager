// DnsManager version resource (generated from version.rc.in by CMake).
// All @PLACEHOLDERS@ are substituted from the project version.
#include <windows.h>

// Application icon. The path is absolute because the generated .rc lives in
// the build directory while the icon stays in the source tree.
IDI_ICON1 ICON "@DNSMGR_APP_ICON_PATH@"

#ifdef __GNUC__
#define VERSION_COUNTRY 1200
#else
#define VERSION_COUNTRY 0
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @DNSMGR_VERSION_MAJOR@,@DNSMGR_VERSION_MINOR@,@DNSMGR_VERSION_PATCH@,@DNSMGR_VERSION_BUILD@
 PRODUCTVERSION  @DNSMGR_VERSION_MAJOR@,@DNSMGR_VERSION_MINOR@,@DNSMGR_VERSION_PATCH@,@DNSMGR_VERSION_BUILD@
 FILEFLAGSMASK   0x3fL
#ifdef _DEBUG
 FILEFLAGS       0x1L
#else
 FILEFLAGS       0x0L
#endif
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "DnsManager"
            VALUE "FileDescription",  "DNS Manager"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "DnsManager"
            VALUE "LegalCopyright",   "Copyright (c) 2026 DnsManager Contributors"
            VALUE "OriginalFilename", "DnsManager.exe"
            VALUE "ProductName",      "DNS Manager"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04b0
    END
END
